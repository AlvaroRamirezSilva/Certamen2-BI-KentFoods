              description="OLE DB Source"
              name="SRC_H_VENTAS"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH ClientesCTE AS (
    SELECT ROW_NUMBER() OVER (ORDER BY ClienteID) AS ID_CLIENTE, ClienteID
    FROM dbo.Clientes
),
ProductosCTE AS (
    SELECT ROW_NUMBER() OVER (ORDER BY ProductoID) AS ID_PRODUCTO, ProductoID
    FROM dbo.Productos
),
EmpleadosCTE AS (
    SELECT ROW_NUMBER() OVER (ORDER BY EmpleadoID) AS ID_EMPLEADO, EmpleadoID
    FROM dbo.Empleados
),
TransportistasCTE AS (
    SELECT ROW_NUMBER() OVER (ORDER BY TransportistaID) AS ID_TRANSPORTISTA, TransportistaID
    FROM dbo.Transportistas
)
SELECT 
    o.OrdenID AS ID_ORDEN,
    pr.ID_PRODUCTO AS ID_PRODUCTO,
    c.ID_CLIENTE AS ID_CLIENTE,
    e.ID_EMPLEADO AS ID_EMPLEADO,
    t.ID_TRANSPORTISTA AS ID_TRANSPORTISTA,
    o.FechaOrden AS ID_TIEMPO,
    d.PrecioUnitario AS PRECIO_UNITARIO,
    d.Cantidad AS CANTIDAD,
    d.Descuento AS DESCUENTO,
    (d.PrecioUnitario * d.Cantidad) AS VENTA_BRUTA,
    ((d.PrecioUnitario * d.Cantidad) * (1 - d.Descuento)) AS VENTA_NETA,
    DATEDIFF(day, o.FechaOrden, o.FechaEnvio) AS DIAS_ENVIO
FROM dbo.Ordenes o
INNER JOIN dbo.DetalleOrden d ON o.OrdenID = d.OrdenID
INNER JOIN ClientesCTE c ON o.ClienteID = c.ClienteID
INNER JOIN ProductosCTE pr ON d.ProductoID = pr.ProductoID
INNER JOIN EmpleadosCTE e ON o.EmpleadoID = e.EmpleadoID
INNER JOIN TransportistasCTE t ON o.EnviadoPor = t.TransportistaID;</property>
