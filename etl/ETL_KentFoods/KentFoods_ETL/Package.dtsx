                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
    ROW_NUMBER() OVER (ORDER BY EmpleadoID) AS ID_EMPLEADO,
    EmpleadoID AS COD_EMPLEADO,
    Nombre AS NOMBRE,
    Apellido AS APELLIDO,
    (RTRIM(Nombre) + ' ' + RTRIM(Apellido)) AS NOM_COMPLETO,
    Cargo AS CARGO,
    FechaNacimiento AS FECHA_NACIMIENTO,
    FechaContratacion AS FECHA_CONTRATACION,
    Ciudad AS CIUDAD,
    Pais AS PAIS
FROM dbo.Empleados;</property>
