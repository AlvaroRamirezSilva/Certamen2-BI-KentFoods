                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
    ROW_NUMBER() OVER (ORDER BY p.ProductoID) AS ID_PRODUCTO,
    p.Producto AS PRODUCTO,
    p.CantidadPorUnidad AS CANTIDAD_POR_UNIDAD,
    p.CategoriaID AS ID_CATEGORIA,
    c.Categoria AS CATEGORIA,
    p.ProveedorID AS ID_PROVEEDOR,
    pr.Proveedor AS PROVEEDOR,
    pr.Pais AS PAIS_PROVEEDOR
FROM dbo.Productos p
LEFT JOIN dbo.Categorias c ON p.CategoriaID = c.CategoriaID
LEFT JOIN dbo.Proveedores pr ON p.ProveedorID = pr.ProveedorID;</property>
